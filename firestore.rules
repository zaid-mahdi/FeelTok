// FeelTok security rules: the source of truth, pasted into the Firebase console.
// Everything not listed here is locked. Each task opens only what it needs.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // True if the request comes from the logged-in user with this ID.
    function isCurrentUser(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // True if the username is 3 to 20 lowercase letters, numbers and underscores.
    function isValidUsername(username) {
      return username is string && username.matches('^[a-z0-9_]{3,20}$');
    }

    // True if the mood is one of the 6 user moods, or no mood (keep in sync
    // with moods.js).
    function isValidMood(mood) {
      return mood == null
        || mood in ['happy', 'sad', 'angry', 'love', 'surprised', 'funny'];
    }

    // True if the value is one of the 6 user moods (not empty). Reactions to
    // posts are moods too.
    function isMood(value) {
      return value in ['happy', 'sad', 'angry', 'love', 'surprised', 'funny'];
    }

    // True if the logged-in user has a profile and is not blocked.
    function isNotBlocked() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.banned == false;
    }

    // True if the post type is one of the 6 post types (keep in sync with
    // postTypes.js). Post types are never moods.
    function isValidPostType(postType) {
      return postType in ['love', 'gratitude', 'apology', 'appreciation',
        'mindfulness', 'thank_you'];
    }

    // True if the data has exactly these fields, no more and no fewer.
    function hasExactly(data, fields) {
      return data.keys().hasOnly(fields) && data.keys().hasAll(fields);
    }

    // True if the profile has exactly the fields and values of a new user, so
    // nobody can sign up as an admin or add other fields.
    function isNewProfile(profile) {
      return profile.keys().hasOnly(['username', 'displayName', 'bio',
          'hasPhoto', 'mood', 'moodUpdatedAt', 'role', 'banned', 'createdAt'])
        && isValidUsername(profile.username)
        && profile.displayName == profile.username
        && profile.bio == ''
        && profile.hasPhoto == false
        && profile.mood == null
        && profile.moodUpdatedAt == null
        && profile.role == 'user'
        && profile.banned == false
        && profile.createdAt == request.time;
    }

    // Usernames: anyone can check if one is taken. A new user claims one in
    // the same step as their profile, so each user can only have one.
    match /usernames/{username} {
      allow get: if true;
      allow create: if isValidUsername(username)
        && request.resource.data.keys().hasOnly(['uid'])
        && isCurrentUser(request.resource.data.uid)
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.username == username;
    }

    // True if a user's change to their own profile only touches the fields
    // they may edit, with valid values. role, banned, username and createdAt
    // can never be changed this way, so nobody can make themselves an admin.
    // hasPhoto must say whether their profile photo exists after this step.
    function isValidOwnProfileUpdate() {
      let profile = request.resource.data;
      return profile.diff(resource.data).affectedKeys()
          .hasOnly(['displayName', 'bio', 'hasPhoto', 'mood', 'moodUpdatedAt'])
        && profile.displayName is string
        && profile.bio is string && profile.bio.size() <= 150
        && profile.hasPhoto == existsAfter(/databases/$(database)/documents/profileImages/$(request.auth.uid))
        && isValidMood(profile.mood)
        && (profile.moodUpdatedAt == null || profile.moodUpdatedAt is timestamp);
    }

    // Users: anyone can read one public profile (not list them all). A new user
    // creates their own profile together with their username, and can later
    // edit only the safe fields of it.
    match /users/{uid} {
      allow get: if true;
      allow create: if isCurrentUser(uid)
        && isNewProfile(request.resource.data)
        && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.username)).data.uid == uid;
      allow update: if isCurrentUser(uid) && isValidOwnProfileUpdate();
    }

    // True if the new post is valid: written by the logged-in user, who is not
    // blocked, with their real username and photo flag, a valid mood and type,
    // text of up to 5,000 characters that isn't only spaces, and all counts at
    // 0. A post with a photo must create the photo in the same step, with the
    // post's ID as the photo's ID.
    function isValidNewPost(postId) {
      let post = request.resource.data;
      let author = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return hasExactly(post, ['authorId', 'authorUsername', 'authorHasPhoto',
          'authorMood', 'postType', 'text', 'imageId', 'reactionCounts',
          'commentCount', 'createdAt'])
        && post.authorId == request.auth.uid
        && author.banned == false
        && post.authorUsername == author.username
        && post.authorHasPhoto == author.hasPhoto
        && isValidMood(post.authorMood)
        && isValidPostType(post.postType)
        && post.text is string
        && post.text.size() <= 5000
        && post.text.matches('(?s).*\\S.*')
        && post.reactionCounts == {'happy': 0, 'sad': 0, 'angry': 0,
          'love': 0, 'surprised': 0, 'funny': 0}
        && post.commentCount == 0
        && post.createdAt == request.time
        && (post.imageId == null
          || (post.imageId == postId
            && getAfter(/databases/$(database)/documents/postImages/$(postId)).data.ownerId == request.auth.uid));
    }

    // How much one mood's count changes when a user's reaction goes from
    // oldReaction to newReaction (each a mood or null): +1, -1 or 0.
    function countChange(mood, oldReaction, newReaction) {
      return (newReaction == mood ? 1 : 0) - (oldReaction == mood ? 1 : 0);
    }

    // True if a change to a post only changes its reaction counts, and by
    // exactly what the user's own reaction change adds and removes in the same
    // step. So nobody can change the counts in any other way.
    function isValidReactionCountUpdate(postId) {
      let reactionPath = /databases/$(database)/documents/posts/$(postId)/reactions/$(request.auth.uid);
      let oldReaction = exists(reactionPath) ? get(reactionPath).data.reaction : null;
      let newReaction = existsAfter(reactionPath) ? getAfter(reactionPath).data.reaction : null;
      let oldCounts = resource.data.reactionCounts;
      let newCounts = request.resource.data.reactionCounts;
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactionCounts'])
        && oldReaction != newReaction
        && hasExactly(newCounts, ['happy', 'sad', 'angry', 'love', 'surprised', 'funny'])
        && newCounts.happy == oldCounts.happy + countChange('happy', oldReaction, newReaction)
        && newCounts.sad == oldCounts.sad + countChange('sad', oldReaction, newReaction)
        && newCounts.angry == oldCounts.angry + countChange('angry', oldReaction, newReaction)
        && newCounts.love == oldCounts.love + countChange('love', oldReaction, newReaction)
        && newCounts.surprised == oldCounts.surprised + countChange('surprised', oldReaction, newReaction)
        && newCounts.funny == oldCounts.funny + countChange('funny', oldReaction, newReaction);
    }

    // True if the author changes only the copies of their username and
    // "has a photo" on their own post, to the values in their profile (after
    // this step). Needed when they change their photo or username.
    function isValidAuthorDetailsUpdate() {
      let post = request.resource.data;
      let author = getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return resource.data.authorId == request.auth.uid
        && post.diff(resource.data).affectedKeys().hasOnly(['authorUsername', 'authorHasPhoto'])
        && post.authorUsername == author.username
        && post.authorHasPhoto == author.hasPhoto;
    }

    // True if the post's count for this mood changes by `change` (1 or -1) in
    // the same step, so a reaction can't be saved without its count.
    function isPostCountChanged(postId, mood, change) {
      let postPath = /databases/$(database)/documents/posts/$(postId);
      return getAfter(postPath).data.reactionCounts[mood] == get(postPath).data.reactionCounts[mood] + change;
    }

    // True if a change to a post only adds or takes 1 from its comment count.
    // The comment rules below make adding or deleting a comment change it too.
    function isValidCommentCountUpdate() {
      let newCount = request.resource.data.commentCount;
      let oldCount = resource.data.commentCount;
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentCount'])
        && (newCount == oldCount + 1 || newCount == oldCount - 1)
        && newCount >= 0;
    }

    // True if the post's comment count changes by `change` (1 or -1) in the
    // same step, so a comment can't be added or deleted without its count.
    function isPostCommentCountChanged(postId, change) {
      let postPath = /databases/$(database)/documents/posts/$(postId);
      return getAfter(postPath).data.commentCount == get(postPath).data.commentCount + change;
    }

    // True if the new comment is valid: written by the logged-in user with
    // their real username, text of up to 500 characters that isn't only
    // spaces, the server's time, and the post's count goes up by 1.
    function isValidNewComment(postId) {
      let comment = request.resource.data;
      let author = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return hasExactly(comment, ['authorId', 'authorUsername', 'text', 'createdAt'])
        && comment.authorId == request.auth.uid
        && comment.authorUsername == author.username
        && comment.text is string
        && comment.text.size() <= 500
        && comment.text.matches('(?s).*\\S.*')
        && comment.createdAt == request.time
        && isPostCommentCountChanged(postId, 1);
    }

    // True if the post is being deleted by its author in this same step, or
    // is already gone. Then its comments and reactions (also other people's)
    // can be deleted with it, so nothing is left behind.
    function isPostDeletedWithIt(postId) {
      let postPath = /databases/$(database)/documents/posts/$(postId);
      return request.auth != null
        && (!exists(postPath)
          || (get(postPath).data.authorId == request.auth.uid && !existsAfter(postPath)));
    }

    // Posts: anyone, even logged out, can read them (the For You feed). A
    // logged-in user can create a valid post as themselves. Any logged-in user
    // who isn't blocked can change the reaction counts, only together with
    // their own reaction (users can react to their own posts too), and the
    // comment count by 1, when they add or delete their own comment. Authors
    // can update the copies of their username and photo flag, and delete their
    // own posts, together with the post's photo. Posts can't be edited.
    match /posts/{postId} {
      allow get, list: if true;
      allow create: if request.auth != null && isValidNewPost(postId);
      allow update: if request.auth != null
        && (isValidAuthorDetailsUpdate()
          || (isNotBlocked()
            && (isValidReactionCountUpdate(postId) || isValidCommentCountUpdate())));
      allow delete: if request.auth != null
        && resource.data.authorId == request.auth.uid
        && isNotBlocked()
        && (resource.data.imageId == null
          || !existsAfter(/databases/$(database)/documents/postImages/$(postId)));

      // Comments: anyone can read them. A logged-in user who isn't blocked can
      // add comments as themselves and delete only their own (deleting other
      // people's comments is for admins, Task 17), except when the whole post
      // is deleted. Comments can't be edited.
      match /comments/{commentId} {
        allow get, list: if true;
        allow create: if request.auth != null
          && isNotBlocked()
          && isValidNewComment(postId);
        allow delete: if isPostDeletedWithIt(postId)
          || (request.auth != null
            && resource.data.authorId == request.auth.uid
            && isNotBlocked()
            && isPostCommentCountChanged(postId, -1));
      }

      // Reactions: one per user per post, saved under the user's ID. Anyone
      // can read them. Users can set, switch or remove only their own, to one
      // of the 6 moods, together with the post's count. All of a post's
      // reactions are deleted with the post.
      match /reactions/{uid} {
        allow get, list: if true;
        allow create, update: if isCurrentUser(uid)
          && isNotBlocked()
          && hasExactly(request.resource.data, ['reaction'])
          && isMood(request.resource.data.reaction)
          && isPostCountChanged(postId, request.resource.data.reaction, 1);
        allow delete: if isPostDeletedWithIt(postId)
          || (isCurrentUser(uid)
            && isNotBlocked()
            && isPostCountChanged(postId, resource.data.reaction, -1));
      }
    }

    // Profile photos: anyone can read one photo (not list them all). Users
    // save only their own, under their user ID, as base64 text of up to
    // 300,000 characters, together with hasPhoto = true on their profile. A
    // new photo replaces the old one.
    match /profileImages/{uid} {
      allow get: if true;
      allow create, update: if isCurrentUser(uid)
        && hasExactly(request.resource.data, ['data', 'updatedAt'])
        && request.resource.data.data is string
        && request.resource.data.data.size() > 0
        && request.resource.data.data.size() <= 300000
        && request.resource.data.updatedAt == request.time
        && getAfter(/databases/$(database)/documents/users/$(uid)).data.hasPhoto == true;
    }

    // Post photos: anyone can read one photo (not list them all). Created only
    // together with their post (same ID), by the post's author, as base64 text
    // of up to 900,000 characters, so it always fits in a Firestore document.
    // Deleted only by their owner, together with their post.
    match /postImages/{imageId} {
      allow get: if true;
      allow delete: if request.auth != null
        && resource.data.ownerId == request.auth.uid
        && !existsAfter(/databases/$(database)/documents/posts/$(imageId));
      allow create: if request.auth != null
        && hasExactly(request.resource.data, ['ownerId', 'data', 'createdAt'])
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.data is string
        && request.resource.data.data.size() > 0
        && request.resource.data.data.size() <= 900000
        && request.resource.data.createdAt == request.time
        && getAfter(/databases/$(database)/documents/posts/$(imageId)).data.authorId == request.auth.uid
        && getAfter(/databases/$(database)/documents/posts/$(imageId)).data.imageId == imageId;
    }
  }
}
